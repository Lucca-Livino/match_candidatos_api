{
  "name": "match-de-curriculos-api",
  "version": "1.0.0",
  "description": "To make it easy for you to get started with GitLab, here's a list of recommended next steps.",
  "main": "index.js",
  "scripts": {
    "dev:docker": "docker compose -f docker-compose.yml up --build --force-recreate",
    "dev": "nodemon server.js",
    "seed": "npm run _seed_local",
    "_seed_local": "node src/seeds/seeds.js",
    "seed:docker": "docker compose run --rm -T api npm run _seed_local",
    "seed:auto": "docker compose --profile seed up --build --force-recreate",
    "start": "node server.js",
    "start:production": "docker compose -f docker-compose.yml up --build --force-recreate",
    "test": "jest --coverage"
  },
  "repository": {
    "type": "git",
    "url": "ssh://git@gitlab.fslab.dev:6666/match-de-curriculos/match-de-curriculos-api.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "bcrypt": "^6.0.0",
    "better-auth": "^1.6.9",
    "dotenv": "^17.4.0",
    "express": "^5.2.1",
    "faker-br": "^0.5.0",
    "mongodb": "^7.1.1",
    "mongoose": "^9.3.3",
    "mongoose-paginate-v2": "^1.9.4",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@babel/helper-annotate-as-pure": "^7.27.3",
    "@babel/preset-env": "^7.29.2",
    "@eslint/js": "^10.0.1",
    "babel-jest": "^30.3.0",
    "babel-plugin-transform-import-meta": "^2.3.3",
    "eslint": "^10.1.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jest": "^29.15.1",
    "eslint-plugin-unused-imports": "^4.4.1",
    "jest": "^30.3.0",
    "mongodb-memory-server": "^11.0.1",
    "nodemon": "^3.1.14",
    "prettier": "^3.8.1",
    "supertest": "^7.2.2"
  },
  "babel": {
    "presets": [
      [
        "@babel/preset-env",
        {
          "targets": {
            "node": "current"
          }
        }
      ]
    ],
    "plugins": [
      "babel-plugin-transform-import-meta"
    ]
  },
  "jest": {
    "transform": {
      "^.+\\.js$": "babel-jest"
    },
    "testEnvironment": "node",
    "verbose": true,
    "setupFilesAfterEnv": [
      "<rootDir>/jest.setup.js"
    ],
    "coveragePathIgnorePatterns": [
      "/node_modules/",
      "/src/config/dbconnect.js",
      "/src/utils/logger.js",
      "/src/utils/helpers/http.js",
      "/src/app.js"
    ]
  }
}
