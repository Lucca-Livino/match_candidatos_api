services:
  # Banco local opcional. A API le DB_URL do .env, entao este servico so sobe
  # sob demanda: `docker compose --profile local up`.
  mongodb:
    profiles:
      - local
    container_name: mongodb-match-de-curriculos
    image: mongo:8
    volumes:
      - vol-mongodb:/data/db
    command: mongod --quiet --logpath /dev/null
    ports:
      - '27017:27017'
    restart: always
    healthcheck:
      test: echo 'db.runCommand("ping").ok' | mongosh localhost:27017/match-de-curriculos --quiet
      interval: 10s
      timeout: 10s
      retries: 5
      start_period: 40s

  api:
    container_name: match-de-curriculos-api
    build: .
    ports:
      - '${APP_PORT:-5000}:${APP_PORT:-5000}'
    # DB_URL nao entra aqui de proposito: no Compose `environment` vence
    # `env_file`, entao declarar o banco neste bloco sobrescreveria de forma
    # silenciosa o DB_URL do .env e apontaria a API para um banco vazio.
    environment:
      - NODE_ENV=production
      - APP_PORT=${APP_PORT:-5000}
    env_file:
      - .env
    restart: always
    healthcheck:
      # /health e a unica rota sem autenticacao: /api/usuarios responde 401 e
      # deixaria o container unhealthy para sempre.
      test: curl -f http://localhost:${APP_PORT:-5000}/health || exit 1
      interval: 10s
      timeout: 5s
      retries: 5
      start_period: 30s

  seeder:
    container_name: match-de-curriculos-seeder
    build: .
    environment:
      - NODE_ENV=production
    env_file:
      - .env
    command: npm run _seed_local
    depends_on:
      api:
        condition: service_healthy
    restart: no
    profiles:
      - seed

volumes:
  vol-mongodb:
