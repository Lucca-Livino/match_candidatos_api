# Ambiente da aplicacao
NODE_ENV=development

# URL de conexao com MongoDB
DB_URL=mongodb://localhost:27017/match_de_curriculos

# Timeouts e pool do MongoDB (milissegundos)
MONGO_SERVER_SELECTION_TIMEOUT_MS=5000
MONGO_SOCKET_TIMEOUT_MS=45000
MONGO_CONNECT_TIMEOUT_MS=10000
MONGO_MAX_POOL_SIZE=10

# Better Auth
BETTER_AUTH_SECRET=troque-por-um-segredo-forte
BETTER_AUTH_URL=http://localhost:5000

# Provedores de LLM (camada gratuita). NUNCA versionar os valores reais
# nem persistir no banco — o sistema so expoe se estao configuradas ou nao.
# Gemini: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Groq: https://console.groq.com/keys
GROQ_API_KEY=
